#!/bin/sh
# The bar's recording indicator (deflisten recording in bar.yuck): what ~/.local/bin/dmenurecord last wrote to
# /tmp/recordingicon, empty while nothing records. dmenurecord pushes each change itself (eww update recording=...);
# this line covers the moments eww starts the variable afresh (daemon start, eww reload at every theme switch, $mod+b
# reopening the bar). Then it only waits, so eww has nothing to restart.
printf '%s\n' "$(head -n 1 /tmp/recordingicon 2>/dev/null)"
exec sleep infinity
