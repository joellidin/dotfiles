#!/usr/bin/env python3
"""dunst's notification history for the eww notification center (notifications.yuck), as JSON lines.

  notifications listen     the deflisten: print the state, then print it again whenever dunst reports a change.
                           No polling: `gdbus monitor` on dunst's object wakes it, and any line re-reads (cmd0
                           PropertiesChanged for historyLength, displayedLength, waitingLength, paused, pauseLevel;
                           NotificationHistoryRemoved/Cleared; a new owner when dunst restarts). Only a changed state
                           is printed. At the history cap (history_length) an eviction changes only displayedLength,
                           which is why every PropertiesChanged counts, not just historyLength.
                           The reads are `busctl call`s (NotificationListHistory is what `dunstctl history` runs) with
                           --auto-start=no: dunst has a D-Bus service file, so a read while it is down (the 80-dunst
                           theme hook restarts it, or it was stopped on purpose) would otherwise start it again. Only
                           `busctl call` honours that flag (get-property activated the service in a test), so the
                           properties come from Properties.GetAll.
  notifications            print the state once
  notifications rm ID      drop entry ID from the history (dunstctl history-rm); a click on a card row or its x
  notifications clear      drop the whole history (dunstctl history-clear)

State: {"ok": dunst answered, "count": entries in the history, "dnd": pause level > 0 (do not disturb, as in
scripts/dnd), "held": notifications waiting while paused, "items": [{"id", "app", "summary", "body", "urg", "t"}]},
newest first by arrival (dunst itself lists them by close time). t is a Unix time (dunst stamps CLOCK_BOOTTIME
microseconds); the card turns it into "4 min" with EWW_TIME, which only ticks while the card is open. Texts are plain
single lines: markup stripped, entities decoded, whitespace folded, backslashes doubled (eww unescapes a label's
text). Only the numeric id ever reaches a command."""
import html, json, os, re, select, signal, subprocess, sys, time

NAME, OBJ, IFACE = "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.dunstproject.cmd0"
EMPTY = {"ok": False, "count": 0, "dnd": False, "held": 0, "items": []}


def run(*cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def text(v, limit):
    s = " ".join(html.unescape(re.sub(r"<[^>]*>", "", v or "")).split())
    if len(s) > limit:
        s = s[:limit - 1].rstrip() + "…"
    return s.replace("\\", "\\\\")


def busctl(*args):
    return run("busctl", "--user", "--auto-start=no", "--json=short", *args)


def state():
    props = busctl("call", NAME, OBJ, "org.freedesktop.DBus.Properties", "GetAll", "s", IFACE)
    hist = props and busctl("call", NAME, OBJ, IFACE, "NotificationListHistory")
    try:
        props = json.loads(props)["data"][0]
        level, held = int(props["pauseLevel"]["data"]), int(props["waitingLength"]["data"])
        entries = json.loads(hist)["data"][0]
        offset = time.time() - time.clock_gettime(time.CLOCK_BOOTTIME)
        get = lambda e, k: e.get(k, {}).get("data")
        items = [{"id": int(get(e, "id")),
                  "app": text(get(e, "appname"), 40),
                  "summary": text(get(e, "summary"), 120),
                  "body": text(get(e, "body"), 200),
                  "urg": str(get(e, "urgency") or "normal").lower(),
                  "t": int(offset + int(get(e, "timestamp") or 0) / 1e6)}
                 for e in sorted(entries, key=lambda e: (int(get(e, "timestamp") or 0), int(get(e, "id"))),
                                 reverse=True)]
    except (TypeError, ValueError, KeyError, IndexError, AttributeError):
        return EMPTY
    return {"ok": True, "count": len(items), "dnd": level > 0, "held": held, "items": items}


def listen():
    last = None

    def emit():
        nonlocal last
        out = json.dumps(state(), ensure_ascii=False, separators=(",", ":"))
        if out != last:
            print(out, flush=True)
            last = out

    # eww stops a deflisten with SIGTERM to its process group, so gdbus goes too
    mon = subprocess.Popen(["stdbuf", "-oL", "gdbus", "monitor", "--session", "--dest", NAME, "--object-path", OBJ],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    signal.signal(signal.SIGTERM, lambda *_: (mon.kill(), sys.exit(0)))
    emit()   # gdbus prints its header and the current owner once subscribed, which re-reads right after
    fd = mon.stdout.fileno()
    while os.read(fd, 65536):                         # blocks until dunst says something
        while select.select([fd], [], [], 0.05)[0]:   # one change sends up to three signals: let them settle
            if not os.read(fd, 65536):
                break
        emit()
    mon.wait()


cmd = sys.argv[1:] or ["once"]
if cmd == ["listen"]:
    listen()
elif cmd == ["once"]:
    print(json.dumps(state(), ensure_ascii=False, separators=(",", ":")))
elif len(cmd) == 2 and cmd[0] == "rm" and re.fullmatch(r"[0-9]{1,10}", cmd[1]):
    os.execvp("dunstctl", ["dunstctl", "history-rm", cmd[1]])
elif cmd == ["clear"]:
    os.execvp("dunstctl", ["dunstctl", "history-clear"])
else:
    sys.exit("usage: notifications [listen | rm ID | clear]")
