#!/usr/bin/env python3
"""Close the open eww popup when a mouse button is pressed anywhere outside it.
Started by scripts/toggle when a popup opens (pid in $XDG_RUNTIME_DIR/eww-outside-watch.pid), killed when it closes.
It only *reads* raw XInput2 button events (xinput test-xi2 --root): nothing covers the screen and the click still
reaches whatever was clicked. Clicks on the bar strip (top 64 px) are left to the bar's own pills."""
import os, re, signal, subprocess, sys
popup = sys.argv[1]
toggle = os.path.join(os.path.dirname(os.path.abspath(__file__)), "toggle")
pidfile = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "eww-outside-watch.pid")
with open(pidfile, "w") as f: f.write(str(os.getpid()))
proc = subprocess.Popen(["stdbuf", "-oL", "xinput", "test-xi2", "--root"], stdout=subprocess.PIPE, text=True)
signal.signal(signal.SIGTERM, lambda *_: (proc.kill(), sys.exit(0)))

def geometry():
    ids = subprocess.run(["xdotool", "search", "--name", f"^Eww - {popup}$"], capture_output=True, text=True).stdout.split()
    if not ids: return None
    info = subprocess.run(["xwininfo", "-id", ids[0]], capture_output=True, text=True).stdout
    g = lambda k: int(re.search(k + r":\s+(-?\d+)", info).group(1))
    return g("Absolute upper-left X"), g("Absolute upper-left Y"), g("Width"), g("Height")

def pointer():
    out = subprocess.run(["xdotool", "getmouselocation", "--shell"], capture_output=True, text=True).stdout
    d = dict(l.split("=", 1) for l in out.split() if "=" in l)
    return int(d.get("X", 0)), int(d.get("Y", 0))

try:
    press = False
    for line in proc.stdout:
        if "(RawButtonPress)" in line: press = True; continue
        if press and line.strip().startswith("detail:"):
            press = False
            if line.split(":", 1)[1].strip() not in ("1", "2", "3"): continue
            x, y = pointer()
            if y < 64: continue
            g = geometry()
            if g is None: break
            gx, gy, gw, gh = g
            if gx <= x < gx + gw and gy <= y < gy + gh: continue
            # hand off detached: toggle kills this watcher first, which must not take the toggle down with it
            subprocess.Popen([toggle, "close-all"], start_new_session=True, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
finally:
    proc.kill()
    try:
        with open(pidfile) as f:
            if f.read().strip() == str(os.getpid()): os.remove(pidfile)
    except OSError: pass
