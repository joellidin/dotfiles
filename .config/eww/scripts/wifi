#!/usr/bin/env python3
"""Wi-Fi for the eww popup.
  (no args)               JSON {enabled, active, networks:[{ssid, signal, bars, security, known, active}]} (max 12)
  refresh                 push a fresh list into eww
  rescan                  ask for a scan and refresh the list for ~9 s with the spinner on (never automatic)
  connect SSID MODE       MODE known|open|new; for `new` the password is asked with rofi. The popup shows
                          "Connecting to ..." with a spinner, then "Connected to ..." or the reason it failed."""
import json, os, subprocess, sys, time
EWW = os.path.expanduser("~/.local/bin/eww")
def run(*a, timeout=60):
    try: return subprocess.run(a, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired: return None
def out(*a, timeout=60):
    r = run(*a, timeout=timeout); return r.stdout if r else ""
def eww(*kv): subprocess.run([EWW, "update", *kv], capture_output=True)
def listing(rescan="no"):
    enabled = "enabled" in out("nmcli", "-t", "radio", "wifi")
    known = set(out("nmcli", "-t", "-f", "NAME", "connection", "show").splitlines())
    nets, seen, active = [], set(), ""
    for line in out("nmcli", "-t", "--escape", "no", "-f", "ACTIVE,SIGNAL,SECURITY,SSID", "device", "wifi", "list", "--rescan", rescan, timeout=30).splitlines():
        parts = line.split(":", 3)
        if len(parts) < 4 or not parts[3] or parts[3] in seen: continue
        seen.add(parts[3]); sig = int(parts[1] or 0)
        bars = "▂▄▆█"[: max(1, (sig + 24) // 25)].ljust(4, "·")
        nets.append({"ssid": parts[3], "signal": sig, "bars": bars, "security": parts[2].strip(),
                     "known": parts[3] in known, "active": parts[0] == "yes"})
        if parts[0] == "yes": active = parts[3]
    nets.sort(key=lambda n: (not n["active"], -n["signal"]))
    return {"enabled": enabled, "active": active, "networks": nets[:12]}
cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "refresh":
    eww("wifi=" + json.dumps(listing()))
elif cmd == "rescan":
    # ask NetworkManager for a scan (returns at once), then refresh the list a few times; never blocks over ~9 s
    if out(EWW, "get", "wifi_scanning").strip() == "true": sys.exit(0)
    eww("wifi_scanning=true")
    run("nmcli", "device", "wifi", "rescan", timeout=5)
    for _ in range(6):
        time.sleep(1.5)
        eww("wifi=" + json.dumps(listing()))
    eww("wifi_scanning=false")
elif cmd == "connect":
    ssid, mode = sys.argv[2], (sys.argv[3] if len(sys.argv) > 3 else "known")
    if out(EWW, "get", "wifi_connecting").strip(): sys.exit(0)        # one attempt at a time
    if mode == "active":                                               # already on it: do not reconnect
        msg = f"Already connected to {ssid}"
        eww(f"wifi_msg={msg}", "wifi_msg_kind=ok"); time.sleep(3)
        if out(EWW, "get", "wifi_msg").strip() == msg: eww("wifi_msg=", "wifi_msg_kind=")
        sys.exit(0)
    pw = ""
    if mode == "new":
        r = run("rofi", "-dmenu", "-password", "-theme", os.path.expanduser("~/.config/rofi/password.rasi"), "-p", f"Password for {ssid}", timeout=600)
        if not r or r.returncode != 0 or not r.stdout.strip(): sys.exit(0)
        pw = r.stdout.rstrip("\n")
    msg = f"Connecting to {ssid}"
    eww(f"wifi_connecting={ssid}", f"wifi_msg={msg}", "wifi_msg_kind=busy")
    args = ["nmcli", "--wait", "30", "device", "wifi", "connect", ssid] + (["password", pw] if pw else [])
    if mode == "known": args = ["nmcli", "--wait", "30", "connection", "up", "id", ssid]
    r = run(*args, timeout=45)
    if r is not None and r.returncode == 0:
        msg, kind = f"Connected to {ssid}", "ok"
    else:
        why = "timed out" if r is None else ((r.stderr or r.stdout).strip().splitlines() or ["failed"])[-1]
        why = why.replace("Error: ", "").split("(")[0].strip().rstrip(".")
        msg, kind = f"Could not connect to {ssid}: {why}", "err"
    eww("wifi_connecting=", f"wifi_msg={msg}", f"wifi_msg_kind={kind}", "wifi=" + json.dumps(listing()))
    time.sleep(6)
    if out(EWW, "get", "wifi_msg").strip() == msg: eww("wifi_msg=", "wifi_msg_kind=")
else:
    print(json.dumps(listing()))
