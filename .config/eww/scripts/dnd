#!/bin/sh
# Do not disturb for the quick settings. Pauses dunst at level 50: your dunstrc gives normal notifications
# override_pause_level 30 (held until DND is off) and critical ones 60 (still shown, e.g. the battery warning).
case "$1" in
  toggle) if [ "$(dunstctl get-pause-level 2>/dev/null || echo 0)" -gt 0 ]; then dunstctl set-pause-level 0; else dunstctl set-pause-level 50; fi ;;
  *)      [ "$(dunstctl get-pause-level 2>/dev/null || echo 0)" -gt 0 ] && echo true || echo false ;;
esac
