#!/bin/sh
# Toggle an eww popup (calendar | agents | control | wifi) right under the mouse pointer. While a popup is open,
# scripts/outside-watch closes it on any click outside it (it only listens; nothing covers the screen).
# `toggle close-all` closes everything. If eww has lost track of a window it still shows on screen, the daemon
# is restarted so nothing can stay stuck.
eww=${EWW:-$HOME/.local/bin/eww}
dir=$(dirname "$0")
pidfile="${XDG_RUNTIME_DIR:-/tmp}/eww-outside-watch.pid"
"$eww" ping >/dev/null 2>&1 || { (cd "$HOME" && "$eww" daemon); sleep 0.5; "$eww" open leftbar; }
heal() {
  # popup windows that exist on the X server although eww does not list them = orphans: restart the daemon
  ghosts=$(xwininfo -root -children 2>/dev/null | grep -cE '"Eww - (calendar|agents|control|wifi|closer)"')
  listed=$("$eww" active-windows 2>/dev/null | grep -cE '^(calendar|agents|control|wifi|closer):')
  if [ "$ghosts" -gt "$listed" ]; then
    for pid in $(pgrep -x eww); do kill "$pid"; done; sleep 0.5
    for pid in $(pgrep -x eww); do kill -9 "$pid"; done
    (cd "$HOME" && setsid -f "$eww" daemon >/dev/null 2>&1); sleep 1; "$eww" open leftbar >/dev/null 2>&1
  fi
}
close_all() {
  [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null; rm -f "$pidfile"
  "$eww" close calendar agents control wifi >/dev/null 2>&1
  "$eww" update calendar_open=false agents_open=false control_open=false wifi_open=false mic_open=false agents_filter=all >/dev/null 2>&1
  heal
}
w=$1
case "$w" in
  close-all|outside) close_all; exit 0 ;;
  calendar) width=440 ;;
  agents)   width=1060 ;;
  wifi|control) width=610 ;;
  *) echo "usage: toggle <calendar|agents|control|wifi|close-all>" >&2; exit 2 ;;
esac
if "$eww" active-windows 2>/dev/null | grep -qE "^$w:"; then close_all; exit 0; fi
close_all
X=; eval "$(xdotool getmouselocation --shell 2>/dev/null)"
sw=$(xdotool getdisplaygeometry 2>/dev/null | cut -d' ' -f1); sw=${sw:-2880}
x=$(( ${X:-$((sw / 2))} - width / 2 )); max=$(( sw - 10 - width ))
[ "$x" -lt 10 ] && x=10; [ "$x" -gt "$max" ] && x=$max
"$eww" update "${w}_open=true"
"$eww" open "$w" --pos "${x}x66" --anchor "top left"
setsid -f "$dir/outside-watch" "$w" >/dev/null 2>&1
exit 0
