#!/bin/sh
# Write _colors.scss from the X resources that theme-mode merges (i3wm.*), so eww popups follow dark/light.
# Called at daemon start and from ~/.config/theme-mode/hooks.d/70-i3 (followed by eww reload).
out="${XDG_CONFIG_HOME:-$HOME/.config}/eww/_colors.scss"
q() { xrdb -query 2>/dev/null | awk -v k="$1:" '$1==k{print $2; exit}'; }
d() { v=$(q "$1"); printf '%s' "${v:-$2}"; }
cat > "$out" <<SCSS
// generated by scripts/colors from xrdb, do not edit
\$bg:      $(d i3wm.pill   '#3c3836');
\$fg:      $(d i3wm.pillfg '#d5c4a1');
\$base00:  $(d i3wm.base00 '#32302f');
\$base01:  $(d i3wm.base01 '#3c3836');
\$base02:  $(d i3wm.base02 '#504945');
\$base03:  $(d i3wm.base03 '#665c54');
\$base04:  $(d i3wm.base04 '#bdae93');
\$base05:  $(d i3wm.base05 '#d5c4a1');
\$red:     $(d i3wm.base08 '#fb4934');
\$orange:  $(d i3wm.base09 '#fe8019');
\$yellow:  $(d i3wm.base0A '#fabd2f');
\$green:   $(d i3wm.base0B '#b8bb26');
\$aqua:    $(d i3wm.base0C '#8ec07c');
\$accent:  $(d i3wm.base0D '#83a598');
\$purple:  $(d i3wm.base0E '#d3869b');
\$accent-fg: $(d i3wm.wsfocus_fg '#32302f');
SCSS
