#!/usr/bin/env python3
"""Jump to a herdr agent: close the eww popups, focus the pane inside herdr, then raise the terminal window running
herdr (the Ghostty window whose title matches the pane, else the only or first Ghostty window)."""
import json, os, subprocess, sys, time
pane = sys.argv[1] if len(sys.argv) > 1 else ""
eww = os.path.expanduser("~/.config/eww/scripts/toggle")
subprocess.run([eww, "close-all"], capture_output=True)
if not pane: sys.exit(0)
subprocess.run(["herdr", "agent", "focus", pane], capture_output=True)
title = ""
try:
    for a in json.loads(subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True).stdout)["result"]["agents"]:
        if a.get("pane_id") == pane: title = a.get("terminal_title_stripped") or ""
except Exception: pass
time.sleep(0.15)
tree = json.loads(subprocess.run(["i3-msg", "-t", "get_tree"], capture_output=True, text=True).stdout)
wins = []
def walk(n):
    if n.get("window") and "ghostty" in (n.get("window_properties", {}).get("class") or "").lower(): wins.append(n)
    for c in n.get("nodes", []) + n.get("floating_nodes", []): walk(c)
walk(tree)
if wins:
    pick = next((x for x in wins if title and title in (x.get("name") or "")), wins[0])
    subprocess.run(["i3-msg", "-q", f"[con_id={pick['id']}] focus"], capture_output=True)
