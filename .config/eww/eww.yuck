;; eww widgets for the polybar bar (X11, i3).
;; - leftbar: always-on window at the top left with three pills (workspace dots, herdr agents, keyboard flag);
;;   polybar draws the clock and the right-hand pills. eww renders the flag emoji, which polybar cannot.
;; - popups (calendar, agents, wifi, control) are opened by scripts/toggle <name> right under the mouse;
;;   scripts/outside-watch closes them on a click outside (it only listens to clicks, nothing covers the screen).
;; - eww kills an :onclick command after 200ms unless the widget sets :timeout; every slow action sets one.
;; Colours come from _colors.scss, generated by scripts/colors from the same X resources polybar uses.

(defvar calendar_open false)
(defvar agents_open false)
(defvar control_open false)
(defvar wifi_open false)
(defvar agents_filter "all")
(defvar mic_open false)
(defvar wifi_scanning false)
(defvar wifi_connecting "")
(defvar wifi_msg "")
(defvar wifi_msg_kind "")

(defpoll kbd        :interval "30s" :initial "⌨" "scripts/kbd")
(defpoll time       :interval "10s" "date '+%H:%M'")
(defpoll date       :interval "60s" "date '+%A %-d %B %Y'")
(defpoll battery    :interval "10s" :run-while control_open :initial '{"percent":0,"status":"Unknown","ac":false,"time":"","icon":""}' "scripts/battery")
(defpoll vol        :interval "2s" :run-while control_open :initial '{"vol":0,"muted":false}' "scripts/volume")
(defpoll brightness :interval "2s" :run-while control_open :initial 0 "scripts/brightness")
(defpoll toggles    :interval "2s" :run-while control_open :initial '{"wifi":true,"bt":false,"dnd":false,"dark":true,"profile":"balanced"}' "scripts/toggles")
(defpoll audio      :interval "3s" :run-while control_open :initial '{"sinks":[],"sources":[],"sink_name":"","source_name":""}' "scripts/audio")
(defpoll agents     :interval "2s" :run-while agents_open  :initial '[]' "scripts/agents")
(defpoll wifi       :interval "5s" :run-while wifi_open    :initial '{"enabled":true,"active":"","networks":[]}' "scripts/wifi")

;; ---------- left bar: workspaces, agents, keyboard flag ----------
(deflisten wsdata :initial '{"ws":[],"mode":"default"}' "scripts/workspaces")
(defpoll agentcount :interval "3s" :initial '{"blocked":0,"done":0,"working":0}' "scripts/agents-count")

;; the focused workspace is a pill twice a dot's width: shape, not colour, marks it (the muted accent alone is
;; about as bright as the grey occupied dots)
(defwidget ws-dot [w]
  (eventbox :cursor "pointer" :onclick "i3-msg -q workspace number ${w.num}"
    (box :space-evenly false :valign "center"
      (box :class "dot-pill" :visible {w.state == "focused"} :valign "center")
      (label :class "dot ${w.state}" :visible {w.state != "focused"}
        :text {w.state == "empty" || w.state == "visible" ? "" : ""}))))

(defwidget leftbar-w []
  (box :class "leftbar" :space-evenly false :spacing 15 :halign "start" :valign "center"
    (box :class "pill ws" :space-evenly false :spacing 0
      (for w in {wsdata.ws} (ws-dot :w w))
      (label :class "mode" :visible {wsdata.mode != "default"} :text {wsdata.mode}))
    (eventbox :cursor "pointer" :timeout "5s" :onclick "scripts/toggle agents"
      (box :class "pill agents" :space-evenly false :spacing 18
        (label :class "ag blocked" :visible {agentcount.blocked > 0} :text " ${agentcount.blocked}")
        (label :class "ag done"    :visible {agentcount.done > 0}    :text " ${agentcount.done}")
        (label :class "ag working" :visible {agentcount.working > 0} :text " ${agentcount.working}")
        (label :class "ag none"    :visible {agentcount.blocked + agentcount.done + agentcount.working == 0} :text "")))
    (eventbox :cursor "pointer" :timeout "5s" :onclick "scripts/kbd cycle"
      (box :class "pill kbd" (label :class "flag" :text kbd)))))

(defwindow leftbar :monitor 0 :stacking "fg" :wm-ignore true
  :geometry (geometry :x "10px" :y "10px" :width "1100px" :height "44px" :anchor "top left")
  (leftbar-w))

(defwidget close-btn []
  (button :class "close" :timeout "5s" :onclick "scripts/toggle close-all" ""))

(defwidget spinner []
  (image :class "spin" :icon "process-working-symbolic" :icon-size "menu"))

;; ---------- calendar ----------
(defwidget calendar-w []
  (box :class "popup calendar" :orientation "v" :space-evenly false :spacing 6
    (box :class "head" :space-evenly false
      (label :class "time" :halign "start" :hexpand true :text time)
      (close-btn))
    (label :class "date" :halign "start" :xalign 0 :text date)
    (calendar :class "cal" :show-week-numbers true)))

(defwindow calendar :monitor 0 :stacking "fg" :windowtype "dialog" :wm-ignore true
  :geometry (geometry :x "1220px" :y "66px" :width "440px" :anchor "top left")
  (calendar-w))

;; ---------- herdr agents ----------
(defwidget filter-chip [status label]
  (button :class "chip ${status} ${agents_filter == status ? 'sel' : ''} ${jq(agents, '[.[] | select(.status == \"' + status + '\")] | length') == 0 ? 'zero' : ''}"
          :onclick "${EWW_CMD} update agents_filter=${agents_filter == status ? 'all' : status}"
    "${jq(agents, '[.[] | select(.status == \"' + status + '\")] | length')} ${label}"))

(defwidget agent-row [a]
  (eventbox :cursor "pointer" :visible {agents_filter == "all" || a.status == agents_filter}
            :timeout "10s" :onclick "scripts/agent-focus '${a.pane}'"
    (box :class "agent ${a.status}" :space-evenly false :spacing 18
      (box :class "status-bar" :orientation "v" (label :text ""))
      (box :orientation "v" :hexpand true :space-evenly false :spacing 4
        (box :space-evenly false :spacing 12
          (label :class "title" :halign "start" :xalign 0 :limit-width 52 :text {a.title})
          (label :class "chip ${a.status}" :text {a.status}))
        (label :class "meta" :halign "start" :xalign 0 :text "workspace ${a.ws}    ${a.agent}    ${a.cwd}"))
      (label :class "go" :text ""))))

(defwidget agents-w []
  (box :class "popup agents" :orientation "v" :space-evenly false :spacing 12
    (box :class "head" :space-evenly false :spacing 14
      (label :class "heading" :halign "start" :text "Agents")
      (box :class "counts" :hexpand true :halign "start" :space-evenly false :spacing 8
        (filter-chip :status "blocked" :label "blocked")
        (filter-chip :status "done"    :label "done")
        (filter-chip :status "working" :label "working")
        (filter-chip :status "idle"    :label "idle"))
      (close-btn))
    (label :class "hint" :halign "start" :xalign 0 :text {agents_filter == "all" ? "blocked = waiting at a prompt, done = finished and not yet looked at. Click a chip to filter, a row to jump there." : "showing ${agents_filter} only, click the chip again for all"})
    (label :class "empty" :visible {arraylength(agents) == 0} :text "no agents running")
    (scroll :vscroll true :hscroll false :height 760
      (box :orientation "v" :spacing 8 :space-evenly false
        (for a in agents (agent-row :a a))))))

(defwindow agents :monitor 0 :stacking "fg" :windowtype "dialog" :wm-ignore true
  :geometry (geometry :x "10px" :y "66px" :width "1060px" :anchor "top left")
  (agents-w))

;; ---------- wi-fi ----------
(defwidget net-row [n]
  (eventbox :cursor "pointer" :timeout "120s"
            :onclick "scripts/wifi connect '${n.ssid}' ${n.active ? 'active' : n.known ? 'known' : (n.security == '' ? 'open' : 'new')}"
    (box :class "net ${n.active ? 'active' : ''} ${wifi_connecting == n.ssid ? 'connecting' : ''}" :space-evenly false :spacing 16
      (label :class "bars" :text {n.bars})
      (label :class "ssid" :halign "start" :hexpand true :xalign 0 :limit-width 28 :text {n.ssid})
      (box :visible {wifi_connecting == n.ssid} :space-evenly false :spacing 8
        (spinner)
        (label :class "state busy" :text "connecting"))
      (label :class "state ok" :visible {n.active && wifi_connecting != n.ssid} :text "connected")
      (label :class "lock" :visible {n.security != "" && !n.active && wifi_connecting != n.ssid} :text ""))))

(defwidget wifi-w []
  (box :class "popup wifi" :orientation "v" :space-evenly false :spacing 10
    (box :class "head" :space-evenly false :spacing 10
      (label :class "heading" :halign "start" :hexpand true :text "Wi-Fi")
      (button :class "small ${wifi.enabled ? 'on' : ''}" :timeout "15s"
              :onclick "nmcli radio wifi ${wifi.enabled ? 'off' : 'on'}; sleep 1; scripts/wifi refresh"
              {wifi.enabled ? "On" : "Off"})
      (button :class "small ${wifi_scanning ? 'busy' : ''}" :timeout "40s" :onclick "scripts/wifi rescan"
        (box :space-evenly false :spacing 8
          (image :class {wifi_scanning ? "spin" : "still"} :icon "view-refresh-symbolic" :icon-size "menu")
          (label :text {wifi_scanning ? "Scanning" : "Rescan"})))
      (close-btn))
    (box :class "wmsg ${wifi_msg_kind}" :visible {wifi_msg != ""} :space-evenly false :spacing 10
      (box :visible {wifi_msg_kind == "busy"} (spinner))
      (label :xalign 0 :hexpand true :halign "start" :wrap true :text wifi_msg))
    (label :class "empty" :visible {arraylength(wifi.networks) == 0}
           :text {!wifi.enabled ? "Wi-Fi is off" : wifi_scanning ? "scanning for networks" : "no networks found"})
    (label :class "hint" :halign "start" :xalign 0 :visible {wifi.enabled && !wifi_scanning && arraylength(wifi.networks) <= 1}
           :text "Only known results are listed. Press Rescan to look for other networks.")
    (box :orientation "v" :spacing 4 :space-evenly false
      (for n in {wifi.networks} (net-row :n n)))))

(defwindow wifi :monitor 0 :stacking "fg" :windowtype "dialog" :wm-ignore true
  :geometry (geometry :x "2270px" :y "66px" :width "600px" :anchor "top left")
  (wifi-w))

;; ---------- quick settings ----------
(defwidget battery-w []
  (box :class "battery" :space-evenly false :spacing 18
    (label :class "bicon ${battery.ac ? 'ac' : battery.percent <= 15 ? 'low' : ''}" :text {battery.icon})
    (box :orientation "v" :space-evenly false :hexpand true
      (label :class "bpct" :halign "start" :xalign 0 :text "${battery.percent}%")
      (label :class "bstate" :halign "start" :xalign 0
             :text {battery.status == "Charging" ? "Charging${battery.time != '' ? ', ' + battery.time + ' to full' : ''}"
                   : battery.status == "Discharging" ? "On battery${battery.time != '' ? ', ' + battery.time + ' left' : ''}"
                   : battery.ac ? "Plugged in, fully charged" : battery.status}))))

(defwidget slider [title icon value cmd]
  (box :orientation "v" :space-evenly false :spacing 4
    (label :class "section" :halign "start" :xalign 0 :text title)
    (box :class "slider" :space-evenly false :spacing 14
      (label :class "icon" :text icon)
      (scale :hexpand true :min 0 :max 101 :value value :timeout "2s" :onchange cmd)
      (label :class "pct" :text "${value}%"))))

(defwidget volume-slider []
  (box :orientation "v" :space-evenly false :spacing 4
    (label :class "section" :halign "start" :xalign 0
           :text {vol.muted ? "Volume (muted)" : "Volume"})
    (box :class "slider ${vol.muted ? 'muted' : ''}" :space-evenly false :spacing 14
      (button :class "icon mutebtn" :timeout "3s" :tooltip "Mute or unmute"
              :onclick "scripts/volume toggle; scripts/refresh volume 0.2" {vol.muted ? "" : ""})
      (scale :hexpand true :min 0 :max 101 :value {vol.vol} :timeout "3s" :onchange "scripts/volume set {}")
      (label :class "pct" :text {vol.muted ? "muted" : "${vol.vol}%"}))))

(defwidget toggle [label icon on cmd]
  (button :class "toggle ${on ? 'on' : ''}" :timeout "15s" :onclick "${cmd}; scripts/refresh toggles"
    (box :orientation "v" :spacing 6 (label :class "ticon" :text icon) (label :class "tlabel" :text label))))

(defwidget profile-btn [name label]
  (button :class "profile ${toggles.profile == name ? 'on' : ''}" :timeout "10s"
          :onclick "powerprofilesctl set ${name}; scripts/refresh toggles 0.2" label))

(defwidget device-btn [d kind]
  (button :class "device ${d.default ? 'on' : ''}" :halign "fill" :timeout "10s"
          :onclick "scripts/audio ${kind} '${d.name}'; scripts/refresh audio 0.3"
    (box :space-evenly false :spacing 12
      (label :class "radio" :text {d.default ? "" : ""})
      (label :halign "start" :xalign 0 :limit-width 40 :text {d.desc}))))

(defwidget control-w []
  (box :class "popup control" :orientation "v" :space-evenly false :spacing 18
    (box :class "head" :space-evenly false
      (label :class "heading" :halign "start" :hexpand true :text "Quick settings")
      (close-btn))
    (battery-w)
    (volume-slider)
    (box :orientation "v" :space-evenly false :spacing 6
      (label :class "section" :halign "start" :xalign 0 :text "Sound output")
      (box :orientation "v" :spacing 4 :space-evenly false
        (for d in {audio.sinks} (device-btn :d d :kind "set-sink"))))
    (slider :title "Brightness" :icon "" :value brightness :cmd "scripts/brightness set {}")
    (box :orientation "v" :space-evenly false :spacing 6
      (label :class "section" :halign "start" :xalign 0 :text "Radios, notifications, theme")
      (box :class "toggles" :spacing 10 :homogeneous true
        (toggle :label "Wi-Fi"     :icon "" :on {toggles.wifi} :cmd "nmcli radio wifi ${toggles.wifi ? 'off' : 'on'}")
        (toggle :label "Bluetooth" :icon ""   :on {toggles.bt}   :cmd "bluetoothctl power ${toggles.bt ? 'off' : 'on'}")
        (toggle :label "No alerts" :icon "" :on {toggles.dnd} :cmd "scripts/dnd toggle")
        (toggle :label {toggles.dark ? "Dark" : "Light"} :icon {toggles.dark ? "" : ""} :on {toggles.dark} :cmd "$HOME/.local/bin/theme-mode toggle")))
    (box :orientation "v" :space-evenly false :spacing 6
      (label :class "section" :halign "start" :xalign 0 :text "Power profile")
      (box :class "profiles" :spacing 10 :homogeneous true
        (profile-btn :name "power-saver" :label "Saver")
        (profile-btn :name "balanced"    :label "Balanced")
        (profile-btn :name "performance" :label "Performance")))
    (box :orientation "v" :space-evenly false :spacing 6
      (button :class "microw" :onclick "${EWW_CMD} update mic_open=${!mic_open}"
        (box :space-evenly false :spacing 12
          (label :class "micicon" :text "")
          (label :class "section" :text "Microphone")
          (label :class "micname" :hexpand true :halign "start" :xalign 0 :limit-width 30 :text {audio.source_name})
          (label :class "section" :text {mic_open ? "" : ""})))
      (revealer :reveal mic_open :transition "slidedown" :duration "150ms"
        (box :orientation "v" :spacing 4 :space-evenly false
          (for d in {audio.sources} (device-btn :d d :kind "set-source")))))))

(defwindow control :monitor 0 :stacking "fg" :windowtype "dialog" :wm-ignore true
  :geometry (geometry :x "2270px" :y "66px" :width "600px" :anchor "top left")
  (control-w))
