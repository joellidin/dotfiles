#!/bin/sh
# Write dunstrc.d/50-theme.conf from the X resources theme-mode merges (i3wm.*), the palette rofi (rofi/gen-colors)
# and the eww popups use, so notifications follow dark/light. Run by ~/.config/theme-mode/hooks.d/80-dunst, which then
# reloads dunst. Each urgency section sets all four colours: dunst applies urgency sections as rules and reapplies them
# on reload, so notices on screen and in history change colour too. Keep colours out of `format` in dunstrc: dunst
# formats a notice's text once, when it arrives. bg = card, edge = 2 px frame, dim = low urgency text,
# accent = progress bar fill.
out="${XDG_CONFIG_HOME:-$HOME/.config}/dunst/dunstrc.d/50-theme.conf"
res=$(xrdb -query 2>/dev/null)
d() { v=$(printf '%s\n' "$res" | awk -v k="$1:" '$1==k{print $2; exit}'); printf '%s' "${v:-$2}"; }
bg=$(d i3wm.pill '#3c3836') edge=$(d i3wm.base02 '#504945') fg=$(d i3wm.base06 '#ebdbb2')
dim=$(d i3wm.base04 '#bdae93') accent=$(d i3wm.base0D '#d6a0ae') urgent=$(d i3wm.base08 '#fb4934')
mkdir -p "${out%/*}"
# temp name without .conf (dunst reads only *.conf), then mv: atomic, and it replaces the old themes/ symlink
# instead of writing through it
tmp="$out.tmp.$$"
cat >"$tmp" <<CONF
# generated by ~/.config/dunst/gen-colors from xrdb, do not edit
[urgency_low]
    background = "$bg"
    foreground = "$dim"
    frame_color = "$edge"
    highlight = "$dim"
[urgency_normal]
    background = "$bg"
    foreground = "$fg"
    frame_color = "$edge"
    highlight = "$accent"
[urgency_critical]
    background = "$bg"
    foreground = "$fg"
    frame_color = "$urgent"
    highlight = "$urgent"
CONF
mv -f "$tmp" "$out"
