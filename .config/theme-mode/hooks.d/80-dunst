#!/usr/bin/sh
# dunst colours for $1 (dark|light): regenerate dunstrc.d/50-theme.conf from the X resources that 70-i3 has just
# merged, then reload the running dunst in place. dunst 1.12 rescans dunstrc.d on reload and recolours the notices on
# screen and in history; the process and its history stay. Test: sh ~/.claude/plans/test-dunst.sh
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/dunst"
"$cfg/gen-colors" || exit 0
# not running: nothing to reload, the next notification starts dunst (D-Bus activation) with the new file
dbus-send --session --print-reply=literal --dest=org.freedesktop.DBus /org/freedesktop/DBus \
  org.freedesktop.DBus.NameHasOwner string:org.freedesktop.Notifications 2>/dev/null | grep -q true || exit 0
# reload resets the pause level to 0, which would turn off do-not-disturb (eww scripts/dnd: level 50); restore it
level=$(dunstctl get-pause-level 2>/dev/null)
dunstctl reload
case "$level" in ''|*[!0-9]*|0) ;; *) dunstctl set-pause-level "$level" ;; esac
exit 0
