#!/bin/sh
# Write colors.rasi from the X resources theme-mode merges (i3wm.*), so every rofi menu follows dark/light.
# Run by ~/.config/theme-mode/hooks.d/75-rofi on each switch and at login (darkman applies the mode then).
# rofi reads the theme at every launch, so nothing needs reloading. field = input fields, edge = card border,
# accent-soft = a pale accent surface (the password card's key badge).
out="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/colors.rasi"
q() { xrdb -query 2>/dev/null | awk -v k="$1:" '$1==k{print $2; exit}'; }
d() { v=$(q "$1"); printf '%s' "${v:-$2}"; }
tmp="$out.tmp.$$"
cat >"$tmp" <<RASI
/* generated by gen-colors from xrdb, do not edit */
* {
  bg:          $(d i3wm.pill       '#3c3836');
  field:       $(d i3wm.input_bg   '#504945');
  edge:        $(d i3wm.base02     '#504945');
  fg:          $(d i3wm.base06     '#ebdbb2');
  dim:         $(d i3wm.base04     '#bdae93');
  accent:      $(d i3wm.base0D     '#d6a0ae');
  accent-soft: $(d i3wm.wsfocus_bg '#493b43');
  on-accent:   $(d i3wm.pill       '#3c3836');
  urgent:      $(d i3wm.base08     '#fb4934');
}
RASI
mv -f "$tmp" "$out"  # atomic, so a rofi starting mid-switch never reads half a file
