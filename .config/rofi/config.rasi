/* rofi 2.0 settings. Every plain `rofi` call (launchers, -dmenu menus, password prompts) gets the shared look
   in theme.rasi, which follows dark/light through colors.rasi. Spotlight ($mod+space) has its own layout in
   spotlight/spotlight.rasi with the same colours. */
configuration {
  modi: "drun,run,window";
  show-icons: false;               /* on per launcher (-show-icons), so text menus get no empty icon slot */
  icon-theme: "Yaru";
  dpi: 176;                        /* same as Xft.dpi */
  terminal: "ghostty";
  drun-display-format: "{name}";
  drun-match-fields: "name,generic,exec,categories,keywords";
  display-drun: "Apps";
  display-run: "Run";
  display-window: "Windows";
  case-sensitive: false;
  normalize-match: true;
  matching: "fuzzy";
  sort: true;
  sorting-method: "fzf";
  cycle: true;
  scroll-method: 0;
  click-to-exit: true;
  hover-select: false;             /* true made a resting pointer pick the row under it, so Enter could open the wrong entry */
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  kb-cancel: "Escape,Control+g";
}
@theme "~/.config/rofi/theme.rasi"
