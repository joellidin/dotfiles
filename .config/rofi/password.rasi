/* Password prompts (sudo askpass, YubiKey PIN, Wi-Fi password): a card that hangs from the top edge of the screen,
   centred, like the old adi1090x prompt: a key emblem, the prompt as a centred heading, the masked input and a quiet
   key hint. Square top corners against the screen edge; picom leaves rofi's corners to rofi (rule in picom.conf).
   Shared look and colours from theme.rasi. -password in the caller masks the input, not this theme. Use:
     rofi -dmenu -password -theme ~/.config/rofi/password.rasi -p "YubiKey PIN" </dev/null
   One quoted value per line: rofi's lexer matches a string from the first to the last quote on a line. */
@import "theme.rasi"

window {
  location: north; anchor: north;
  x-offset: 0px; y-offset: 0px;
  width: 760px;
  border: 0px 2px 2px 2px; border-color: @edge;
  border-radius: 0px 0px 24px 24px;
}
mainbox {
  padding: 28px; spacing: 16px;
  children: [ badge-row, title-row, message, inputbar, textbox-help ];
}

/* rofi sizes the prompt and custom textboxes to their text, so centring needs a spacer box on each side */
badge-row { orientation: horizontal; expand: false; children: [ badge-left, textbox-emblem, badge-right ]; }
title-row { orientation: horizontal; expand: false; children: [ title-left, prompt, title-right ]; }
badge-left, badge-right, title-left, title-right { expand: true; }

textbox-emblem {
  expand: false; width: 120px; padding: 14px 0px;
  border: 2px; border-color: @accent-soft; border-radius: 60px;
  background-color: @accent-soft; text-color: @accent;
  horizontal-align: 0.5; vertical-align: 0.5;
  str: "󰌋";
  font: "Symbols Nerd Font 36";
}
prompt {
  expand: false; horizontal-align: 0.5; text-color: @fg;
  font: "JetBrainsMono Nerd Font Bold 14";
}

/* -mesg (account, network, error) shows as centred secondary text under the heading */
message { padding: 0px; }
textbox { horizontal-align: 0.5; }

inputbar {
  expand: false; padding: 14px 20px;
  border: 2px; border-color: @accent; border-radius: 14px;
  background-color: @field;
  children: [ entry ];
}
entry {
  horizontal-align: 0.0; text-color: @fg;
  font: "JetBrainsMono Nerd Font 16";
}

textbox-help {
  expand: false; horizontal-align: 0.5; text-color: @dim;
  str: "Enter to confirm · Esc to cancel";
  font: "JetBrainsMono Nerd Font 10";
}
