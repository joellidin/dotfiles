[commit]
	gpgsign = true
[core]
    pager = delta-auto
[interactive]
    diffFilter = delta-auto --color-only
[delta]
    line-numbers = true
    side-by-side = true
    file-modified-label = modified
    navigate = true
    ; word-diff-regex = .
    ; syntax-theme and diff-so-fancy live in the two feature sets below; the
    ; delta-auto pager picks one from the desktop theme (darkman).
[delta "dark-mode"]
    dark = true
    syntax-theme = gruvbox-dark
    diff-so-fancy = true
[delta "light-mode"]
    light = true
    syntax-theme = gruvbox-light
    ; diff-so-fancy look with light emphasis backgrounds instead of 52/22
    commit-style = raw
    file-style = bold blue
    hunk-header-style = bold syntax
    minus-style = bold red
    minus-non-emph-style = bold red
    minus-emph-style = bold red 224
    minus-empty-line-marker-style = normal "#ffd7d7"
    plus-style = bold green
    plus-non-emph-style = bold green
    plus-emph-style = bold green 194
    plus-empty-line-marker-style = normal "#d7ffd7"
    file-added-label = added:
    file-removed-label = removed:
[init]
	defaultBranch = main
[merge]
    conflictstyle = zdiff3
[diff]
	algorithm = histogram
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[help]
	autocorrect = prompt
[fetch]
	prune = true
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
	required = true
[alias]
	update-branch = "!f() { branch=$(git symbolic-ref --short HEAD); if [ \"$branch\" = \"main\" ]; then git pull; else git fetch origin main:main && git rebase main; fi; }; f"
	clone-bare = "!f() { url=\"$1\"; name=\"${2:-$(basename \"$url\" .git)}\"; mkdir -p \"$name\" && cd \"$name\" && git clone --bare \"$url\" .bare && echo \"gitdir: ./.bare\" > .git && git config remote.origin.fetch \"+refs/heads/*:refs/remotes/origin/*\" && git fetch origin && default=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed \"s@refs/remotes/origin/@@\") && git worktree add \"${default:-main}\" \"${default:-main}\" && echo \"Done. cd $name/${default:-main} to start working.\"; }; f"
[rerere]
	enabled = true
[credential "https://git.overleaf.com"]
	helper = store --file ~/.config/git/credentials
