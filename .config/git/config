[commit]
	gpgsign = true
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    line-numbers = true
    syntax-theme = gruvbox-dark
    side-by-side = true
    file-modified-label = modified
    navigate = true
    diff-so-fancy=true
    ; word-diff-regex = .
[init]
	defaultBranch = main
[merge]
    conflictstyle = diff3
[pull]
	rebase = true
[fetch]
	prune = true
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
	required = true
[alias]
	update-branch = "!f() { branch=$(git symbolic-ref --short HEAD); if [ \"$branch\" = \"main\" ]; then git pull; else git fetch origin main:main && git rebase main; fi; }; f"
	clone-bare = "!f() { url=\"$1\"; name=\"${2:-$(basename \"$url\" .git)}\"; mkdir -p \"$name\" && cd \"$name\" && git clone --bare \"$url\" .bare && echo \"gitdir: ./.bare\" > .git && git config remote.origin.fetch \"+refs/heads/*:refs/remotes/origin/*\" && git fetch origin && default=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed \"s@refs/remotes/origin/@@\") && git worktree add \"${default:-main}\" \"${default:-main}\" && echo \"Done. cd $name/${default:-main} to start working.\"; }; f"
[rerere]
	enabled = true
[credential]
	helper = store --file ~/.config/git/credentials
