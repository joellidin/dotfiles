keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard
keybind = alt+shift+k=increase_font_size:1
keybind = alt+shift+j=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = alt+k=scroll_page_lines:-10
keybind = alt+j=scroll_page_lines:10
keybind = alt+u=scroll_page_up
keybind = alt+d=scroll_page_down
# Ghostty default for ctrl+enter is toggle_fullscreen, which hides the i3 bar like $mod+b
keybind = ctrl+enter=unbind

font-feature = -calt

theme = dark:Chalkboard,light:Modus Operandi Tinted
# theme = CLRS
window-decoration = false
background-opacity = 0.90
unfocused-split-opacity = 0.7

# custom-shader = shaders/gears-and-belts.glsl
# custom-shader = shaders/glitchy.glsl
