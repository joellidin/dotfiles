.dotfiles

# zsh
**/.zcompdump*

# nvim
*packer_compiled.vim

# Rewritten by theme-mode on every dark/light toggle
.config/gtk-3.0/settings.ini
.config/gtk-4.0/settings.ini
.config/dunst/dunstrc.d/

# Installed by TPM, not config
.config/tmux/plugins/

# herdr runtime state (sockets, logs, session snapshots); only config.toml is tracked
.config/herdr/*
!.config/herdr/config.toml
