.dotfiles

# zsh
**/.zcompdump*

# nvim
*packer_compiled.vim

# Rewritten by theme-mode on every dark/light toggle
.config/gtk-3.0/settings.ini
.config/gtk-4.0/settings.ini
.config/dunst/dunstrc.d/
.config/eww/_colors.scss
.config/rofi/colors.rasi

# Python bytecode and launchers that uv tools install next to the scripts
.local/bin/__pycache__/
.local/bin/lidin-deploy

# Installed by TPM, not config
.config/tmux/plugins/

# herdr runtime state (sockets, logs, session snapshots); only config.toml is tracked
.config/herdr/*
!.config/herdr/config.toml

# Never publish keys, documents or data exports, wherever they land in $HOME
*.key
*.pdf
*.csv
*.zip
*client_secret*.json
*token*.json
.ssh/
.gnupg/

# nvim: only the config is tracked; anything else dropped in this folder stays private
.config/nvim/*
!.config/nvim/init.lua
!.config/nvim/lazy-lock.json
!.config/nvim/stylua.toml
!.config/nvim/lua/
!.config/nvim/after/
!.config/nvim/ftdetect/
