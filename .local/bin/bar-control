#!/bin/sh
# bar-control: show or hide the top bar, the eww window `bar` (~/.config/eww/bar.yuck).
#   bar-control sync               open the bar unless it is hidden with $mod+b (bar-launch runs this). Waits up to
#                                  5 s for a daemon that is still starting, and never starts one itself
#   bar-control toggle             hide or show the bar ($mod+b); the flag file keeps it hidden through theme switches
#                                  and bar-launch
#   bar-control fullscreen-toggle  $mod+f: i3's fullscreen toggle (the binding keeps calling this)
#   bar-control watch              nothing left to watch: exits at once (for an i3 config that still starts it)
# The bar is an i3 dock with struts, as polybar was: i3 reserves the strip and a fullscreen window covers the bar, so
# nothing has to close it for fullscreen any more (the old eww leftbar was override-redirect and always on top).
eww="$HOME/.local/bin/eww"
run="${XDG_RUNTIME_DIR:-/tmp}"
flag="$run/bar-hidden"        # exists while the bar is hidden by toggle
lock="$run/bar-control.lock"  # held (fd 8) by toggle and sync, so they never interleave
export DISPLAY="${DISPLAY:-:0}"
nl='
'

# run "$@" holding the lock; call as: locked cmd 8>"$lock"
locked() { flock -w 10 8 || return 1; "$@"; }

# Open or close the bar to match the flag, calling "eww open/close" only when its state differs. The state is read
# from eww every time, so changes made elsewhere are noticed. With $1 = wait a starting daemon gets 5 s; otherwise a
# missing daemon means do nothing. This never starts a daemon (a plain "eww open" would, in the caller's cgroup), and
# eww never inherits the lock fd. The old leftbar, if anything still opened it, is closed.
sync_once() {
  n=0  # without a daemon each call fails after 1 s (eww retries the socket), so 5 calls is about 5 s
  until aw=$("$eww" active-windows 2>/dev/null 8>&-); do
    [ "$1" = wait ] && [ $n -lt 4 ] || return 1
    n=$((n + 1))
  done
  case "$nl$aw" in *"${nl}leftbar:"*) "$eww" close leftbar >/dev/null 2>&1 8>&- ;; esac
  case "$nl$aw" in *"${nl}bar:"*) is=open ;; *) is=closed ;; esac
  if [ -e "$flag" ]; then want=closed; else want=open; fi
  [ "$is" = "$want" ] && return 0
  if [ "$want" = open ]; then "$eww" open bar; else "$eww" close bar; fi >/dev/null 2>&1 8>&-
}

toggle() {
  if [ -e "$flag" ]; then rm -f "$flag"; else : >"$flag"; fi
  sync_once wait
}

case "$1" in
  sync) locked sync_once wait 8>"$lock" ;;
  toggle) locked toggle 8>"$lock" ;;
  fullscreen-toggle) i3-msg -q fullscreen toggle ;;
  watch) exit 0 ;;
  *) echo "usage: bar-control sync|toggle|fullscreen-toggle" >&2; exit 2 ;;
esac
