#!/bin/sh
# polybar-launch: (re)start polybar and bring the eww left bar in line (bar-control sync).
# Run by i3 (exec_always in ~/.config/i3/config) and by ~/.config/theme-mode/hooks.d/70-i3 after
# xrdb -merge, so the bar re-reads the ${xrdb:...} colours in ~/.config/polybar/config.ini.
# eww: daemon up, and the left bar (workspaces, agents, keyboard flag) open unless a fullscreen window is
# visible or the bars are hidden with $mod+b (idempotent; bar-control waits up to 5 s for a new daemon)
eww="$HOME/.local/bin/eww"
# Long-running parts are started by i3, so they belong to the desktop session in their own process group,
# whoever runs this script. Started directly from the theme hook they would sit in darkman.service's cgroup
# (killed when darkman restarts) and in the hook's process group (killed if the hook times out).
# Fallback without i3: a plain detached start. No ';' or ',' in the command: i3 splits on them.
session_start() { i3-msg -q "exec --no-startup-id $1" 2>/dev/null || setsid -f sh -c "$1" >/dev/null 2>&1; }
"$eww" ping >/dev/null 2>&1 || { session_start "cd $HOME && $eww daemon"; sleep 0.5; }
"$HOME/.local/bin/bar-control" sync >/dev/null 2>&1 &

if ! command -v polybar >/dev/null 2>&1; then
  notify-send -u critical "polybar is not installed" "sudo apt install polybar" 2>/dev/null
  exit 1
fi
# always a clean stop and start: a bar restarted in place many times (polybar-msg cmd restart) hung on 2026-11-08,
# ignored SIGTERM and dropped clicks; give it 2 s to exit, then SIGKILL
if pgrep -x polybar >/dev/null 2>&1; then
  # polybar runs each module script in its own process group and stops those groups only on a clean exit. A bar that
  # needs the SIGKILL (2026-11-11: stopped wifi, then stalled) leaves the rest running under PID 1, so note the
  # groups now (children that lead their own group) and stop what is left of them once the bar is gone
  kids=$(pgrep -d, -P "$(pgrep -d, -x polybar)" 2>/dev/null)
  groups=$([ -n "$kids" ] && ps -o pid=,pgid= -p "$kids" 2>/dev/null | awk '$1 == $2 {printf "%s%s", s, $1; s = ","}')
  pkill -x polybar
  i=0; while pgrep -x polybar >/dev/null 2>&1 && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
  pkill -9 -x polybar 2>/dev/null
  # old module groups: TERM, up to 1 s, then KILL (pkill -g, not kill -- -PGID: dash's kill rejects that form)
  if [ -n "$groups" ]; then
    pkill -g "$groups" 2>/dev/null
    i=0; while pgrep -g "$groups" >/dev/null 2>&1 && [ $i -lt 10 ]; do sleep 0.1; i=$((i + 1)); done
    pkill -9 -g "$groups" 2>/dev/null
  fi
fi
log="${XDG_CACHE_HOME:-$HOME/.cache}/polybar.log"
session_start "polybar -l warning main >>$log 2>&1"
# bars hidden with $mod+b (bar-control toggle): hide the new bar as soon as its IPC answers (up to 3 s)
if [ -e "${XDG_RUNTIME_DIR:-/tmp}/bar-hidden" ]; then
  i=0; until polybar-msg cmd hide >/dev/null 2>&1 || [ $i -ge 30 ]; do sleep 0.1; i=$((i + 1)); done
fi
