#!/usr/bin/env bash
# i3-lock-custom

set -euo pipefail

# The cached lock image follows the wallpaper: setbg and the theme hook rebuild it in the background
# (~/.local/bin/lockscreen-cache). Here that is a no-op, a short wait for a rebuild still running, or a rebuild
# when bg changed some other way. Never let a failed check stop the lock.
"$HOME/.local/bin/lockscreen-cache" || true

# Lock with the cached image
betterlockscreen -l blur
